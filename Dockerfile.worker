# gatekeeper-worker — Cloud Run Job, 4 vCPU / 8 GB, task timeout 6 h (LLD §13).
#
# Framework-free: the job is handed a task and an environment, not an HTTP request, so
# there is no server here. Model artifacts are never baked in — the worker fetches them
# from the GCS model bucket at startup and verifies sha256 (LK-4), which keeps the image
# small and lets a roster swap happen without a rebuild.

FROM python:3.12-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:0.10.11 /uv /usr/local/bin/uv

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project

COPY gatekeeper/ ./gatekeeper/
# LICENSE too: pyproject declares license = { file = "LICENSE" }, so the project install
# below fails without it.
COPY README.md LICENSE ./
RUN uv sync --frozen --no-dev


FROM python:3.12-slim AS runtime

RUN useradd --create-home --uid 1001 gatekeeper

WORKDIR /app

COPY --from=builder --chown=gatekeeper:gatekeeper /app /app

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

USER gatekeeper

# The task reads GATEKEEPER_RUN_REQUEST_ID / GATEKEEPER_GATE / GATEKEEPER_LEASE_OWNER,
# which the dispatcher supplies as env overrides on the execution.
ENTRYPOINT ["gatekeeper-worker"]
